# Vercel KV / Upstash Redis configuration for Global Leaderboard (optional)
# When you connect "Upstash for Redis" in your Vercel Dashboard, these are set automatically.
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your-upstash-token

# Alternatively, standard Upstash REST environment variable names:
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
